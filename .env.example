# GEMINI_API_KEY: Required for Google Gemini AI Studio calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional server-side API key for OpenAI provider in MEMORA AI Studio.
OPENAI_API_KEY=""

# SPOTIFY CREDENTIALS: Required for Spotify OAuth & Web API playlist integration.
# Create an app at https://developer.spotify.com/dashboard and add <APP_URL>/auth/callback as Redirect URI.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# YOUTUBE / GOOGLE CREDENTIALS: Required for YouTube Data API v3 playlist integration & Google OAuth.
# Enable YouTube Data API v3 in Google Cloud Console and add <APP_URL>/auth/callback as Authorized Redirect URI.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
